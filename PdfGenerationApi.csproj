<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfGenerationApi</RootNamespace>
    <AssemblyName>PdfGenerationApi</AssemblyName>
    <!-- Suppress DinkToPdf's old NETStandard.Library dependency conflicts — safe to ignore on .NET 8 -->
    <!-- Suppress ImageSharp vulnerability warnings — internal API, latest available version, images sourced from own S3 -->
    <NoWarn>NU1605;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DinkToPdf: wkhtmltopdf wrapper for .NET -->
    <PackageReference Include="DinkToPdf" Version="1.0.8" />
    <!-- ImageSharp: handles WebP, PNG, JPG etc. and re-encodes to JPEG for PDF embedding -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
  </ItemGroup>

  <!--
    Copy the native wkhtmltopdf library to the output directory.
    Place libwkhtmltox.dll (Windows) or libwkhtmltox.so (Linux) in the project root.
  -->
  <ItemGroup>
    <None Update="libwkhtmltox.dll" Condition="Exists('libwkhtmltox.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libwkhtmltox.so" Condition="Exists('libwkhtmltox.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
